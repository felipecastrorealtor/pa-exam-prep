# ─────────────────────────────────────────────────────────────────────────────
# PA Real Estate Exam Prep — Environment Variables
# Copy this file to .env.local for local dev (never commit .env.local)
# Set all of these in Netlify → Site Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public — safe in browser) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://ccvvcdypwrcyoyfxyphk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Supabase (server-only — NEVER expose to browser) ─────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Stripe ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard → Products)
STRIPE_PRICE_MONTHLY=price_...           # $20/month recurring
STRIPE_PRICE_MONTHLY_PROMO=price_...    # $15/month (use coupon, not a separate price)
# Coupon ID for $15/mo permanent discount
STRIPE_COUPON_PROMO=coupon_...

# ── Gemini AI (SERVER-ONLY — never in frontend code) ─────────────────────────
# Revoke the old key at aistudio.google.com and create a new one here
GEMINI_API_KEY=your_new_gemini_key_here

# ── App config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ── Admin protection ──────────────────────────────────────────────────────────
# Comma-separated list of emails that get admin access in Supabase profiles
# Better: manage via profiles.role = 'admin' in the database
ADMIN_EMAILS=your-email@example.com

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Get your key at resend.com → API Keys
RESEND_API_KEY=re_...
# Sender address — domain must be verified in Resend
EMAIL_FROM=PA Exam Prep <noreply@repaexam.com>

# ── Analytics (optional — every call is a no-op without the key) ────────────
# PostHog project settings → Project API key (safe to expose; it is public)
NEXT_PUBLIC_POSTHOG_KEY=
# us.i.posthog.com or eu.i.posthog.com, matching your project's region
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Retention sweep (netlify/functions/retention-sweep.ts, daily) ───────────
# Days a lapsed account keeps its study data. Warnings go out 60 and 30 days
# before. Defaults to 365; lower it only to test the flow.
RETENTION_DAYS=365
# Score at or above which a mock exam counts as a pass on the admin dashboard.
ADMIN_PASS_SCORE=75
